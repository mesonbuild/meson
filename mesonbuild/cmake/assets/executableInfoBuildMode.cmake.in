# Import target "@EXECUTABLE_NAME@" for configuration "@CMAKE_BUILD_MODE@"
set_property(TARGET @EXECUTABLE_NAME@ APPEND PROPERTY IMPORTED_CONFIGURATIONS @UPPER_CMAKE_BUILD_MODE@)
set_target_properties(@EXECUTABLE_NAME@ PROPERTIES
  IMPORTED_LOCATION_@UPPER_CMAKE_BUILD_MODE@ "${_IMPORT_PREFIX}/@EXECUTABLE_RELATIVE_PATH@"
)

list(APPEND _cmake_import_check_targets @EXECUTABLE_NAME@)
list(APPEND _cmake_import_check_files_for_@EXECUTABLE_NAME@ "${_IMPORT_PREFIX}/@EXECUTABLE_RELATIVE_PATH@")

