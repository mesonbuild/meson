# Import target "@LIBRARY_NAME@" for configuration "@CMAKE_BUILD_MODE@"
set_property(TARGET @LIBRARY_NAME@ APPEND PROPERTY IMPORTED_CONFIGURATIONS @UPPER_CMAKE_BUILD_MODE@)
set_target_properties(@LIBRARY_NAME@ PROPERTIES
  IMPORTED_LINK_INTERFACE_LANGUAGES_@UPPER_CMAKE_BUILD_MODE@ "@CMAKE_TARGET_COMPILE_LANGUAGES@"
  IMPORTED_LOCATION_@UPPER_CMAKE_BUILD_MODE@ "${_IMPORT_PREFIX}/@LIBRARY_RELATIVE_PATH@"
)

list(APPEND _cmake_import_check_targets @LIBRARY_NAME@)
list(APPEND _cmake_import_check_files_for_@LIBRARY_NAME@ "${_IMPORT_PREFIX}/@LIBRARY_RELATIVE_PATH@")

