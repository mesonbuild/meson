# Ensure empty function are formatted correctly on long lines
a = '@0@@1@@2@@3@@4@'.format(
    'one',
    'two',
    'three',
    'four',
    'five',
).strip().strip()

_opt = get_option('opt') \
    .disable_if(
        true,
        error_message: 'This is an error message because opt can\'t be enabled',
    ) \
    .enable_if(
        false,
        error_message: 'This is an error message because opt can\'t be disabled',
    )
