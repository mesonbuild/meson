# Generated by custom_target() in a child subdir of the generate() root: its
# import name is generated/imported_generated.proto. protos/toplevel.proto
# imports it through `imports`, so it must exist before toplevel.proto is
# compiled.
imported_generated_proto = custom_target(
  'imported_generated_proto',
  output: 'imported_generated.proto',
  command: [gen_proto, '@OUTPUT@'],
)
